PAYMENT_MODE=mock
PUBLIC_BASE_URL=http://localhost:3001
DATABASE_PATH=./data/payments.db
HASHPAY_API_KEY=
HASHPAY_ACCOUNT_ID=
HASHPAY_WEBHOOK_SECRET=
# Set yes only after HashPay confirms legacy STK access for your account.
HASHPAY_STK_ENABLED=yes
# Required on Vercel. Use a pooled PostgreSQL URL with TLS from Neon/Supabase.
DATABASE_URL=https://paymentweb-ten.vercel.app/
# Required for the protected delivery endpoint; use 32+ random characters.
CRON_SECRET=
